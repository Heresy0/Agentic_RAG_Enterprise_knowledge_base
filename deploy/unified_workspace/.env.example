# Compose interpolation only; credentials belong in the ignored private files.
UNIFIED_PROJECT_NAME=knowledge-unified-portable
UNIFIED_IMAGE=enterprise-knowledge-api:unified-local
CADDY_IMAGE=caddy:2-alpine
# Relative to deploy/unified_workspace/, or use an absolute forward-slash path.
UNIFIED_PRIVATE_DIR=../../tmp/unified-workspace-portable
# Network and volumes must already exist on the TARGET machine.
UNIFIED_DEPENDENCY_NETWORK=knowledge-dependencies
KNOWLEDGE_DOCUMENT_VOLUME=restored_knowledge_documents
ERP_DOCUMENT_VOLUME=restored_erp_documents
MES_DOCUMENT_VOLUME=restored_mes_documents
