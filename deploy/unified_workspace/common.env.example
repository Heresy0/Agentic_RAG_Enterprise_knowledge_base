# Copy to the ignored private directory and fill in the existing provider setup.
DASHSCOPE_MODEL=qwen3.7-flash
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=
DASHSCOPE_RERANK_MODEL=
DASHSCOPE_RERANK_URL=
RERANK_TIMEOUT_SECONDS=10
EMBEDDING_TIMEOUT_SECONDS=30

# Browser-visible issuer; JWKS uses the container-reachable dependency address.
OIDC_ISSUER=http://127.0.0.1:8080/realms/enterprise-knowledge
OIDC_AUDIENCE=enterprise-knowledge-api
OIDC_FRONTEND_CLIENT_ID=enterprise-knowledge-unified
OIDC_JWKS_URL=http://keycloak:8080/realms/enterprise-knowledge/protocol/openid-connect/certs

QA_SNAPSHOTS_ENABLED=true
CONVERSATION_MEMORY_ENABLED=true
MODEL_USAGE_PRICES_JSON={}
LOG_LEVEL=INFO
