{
  "version": "2026-10-21-quality-v1",
  "dataset_sha256": "c1ef8bef5a0b5f717d716d40bf00755c42e5f4850ae869958efdb83208ada19d",
  "purpose": "新增排序与语义诊断，不修改120题原问题、事实标准、r10评分或历史结果。正向正则只覆盖已审核表达；未覆盖语义仍需独立复核。",
  "cases": {
    "MH-001": {
      "semantic_assertions": [
        {
          "id": "project_rule_binding",
          "kind": "require",
          "description": "项目适用AR-T2，并在同一结论引用项目规则登记。",
          "patterns": ["(?:适用|采用|绑定|执行|按)AR-T2"],
          "sources": ["51_青屿项目范围与适用规则登记.md"]
        },
        {
          "id": "consecutive_rounds",
          "kind": "require",
          "description": "保留连续两轮全量校验条件。",
          "patterns": ["连续(?:至少)?2轮(?:全量)?校验", "连续(?:至少)?两轮(?:全量)?校验"],
          "sources": ["52_青屿验收接口规则与版本条件.md"]
        },
        {
          "id": "zero_missing_records",
          "kind": "require",
          "patterns": ["(?:记录)?缺失数(?:均)?(?:为|是|等于|=)?0"],
          "sources": ["52_青屿验收接口规则与版本条件.md"]
        },
        {
          "id": "attachment_consistency",
          "kind": "require",
          "patterns": ["附件索引(?:比对)?(?:必须|应当|应|需)?一致"],
          "sources": ["52_青屿验收接口规则与版本条件.md"]
        },
        {
          "id": "closed_defects",
          "kind": "require",
          "patterns": ["(?:不得|不能|不允许|无|没有|不存在).{0,20}D1.{0,12}D2", "D1.{0,12}D2.{0,12}(?:均已|全部|必须)关闭"],
          "sources": ["52_青屿验收接口规则与版本条件.md"]
        },
        {
          "id": "reversed_acceptance_conditions",
          "kind": "forbid",
          "description": "防止关键词齐全但否定验收条件或放行未关闭缺陷。",
          "patterns": [
            "(?:不需要|不必|无需|不要求).{0,8}(?:连续)?(?:2|两)轮",
            "缺失数.{0,8}(?:不必|不需要|无需|不要求).{0,4}0",
            "附件索引.{0,8}(?:不必|无需|不需要).{0,4}一致",
            "(?:D1|D2).{0,20}未关闭.{0,12}(?:允许|可以|可)验收",
            "(?:1|一)轮.{0,12}(?:即可|就能|可以)验收",
            "(?:并非|不是|不能说|不能认为).{0,8}(?:不得|不能|不允许).{0,20}(?:D1|D2)"
          ]
        }
      ]
    }
  }
}
