{
  "ApplicabilityRule": {
    "additionalProperties": false,
    "description": "Auditable source annotation, not a question-specific answer override.",
    "properties": {
      "cutoff_date": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cutoff Date"
      },
      "effective_from": {
        "anyOf": [
          {
            "format": "date",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Effective From"
      },
      "kind": {
        "enum": [
          "start_before",
          "start_on_or_after",
          "work_order_override"
        ],
        "title": "Kind",
        "type": "string"
      },
      "operation_code": {
        "maxLength": 80,
        "minLength": 1,
        "title": "Operation Code",
        "type": "string"
      },
      "product_model": {
        "maxLength": 80,
        "minLength": 1,
        "title": "Product Model",
        "type": "string"
      },
      "review_state": {
        "const": "draft",
        "default": "draft",
        "title": "Review State",
        "type": "string"
      },
      "rule_id": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "title": "Rule Id",
        "type": "string"
      },
      "source_document_id": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "title": "Source Document Id",
        "type": "string"
      },
      "source_quote": {
        "maxLength": 2000,
        "minLength": 2,
        "title": "Source Quote",
        "type": "string"
      },
      "source_quote_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Source Quote Sha256",
        "type": "string"
      },
      "target_business_revision": {
        "maxLength": 80,
        "minLength": 1,
        "title": "Target Business Revision",
        "type": "string"
      },
      "target_document_code": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "title": "Target Document Code",
        "type": "string"
      },
      "work_order_ids": {
        "default": [],
        "items": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "type": "string"
        },
        "title": "Work Order Ids",
        "type": "array"
      }
    },
    "required": [
      "rule_id",
      "kind",
      "target_document_code",
      "target_business_revision",
      "product_model",
      "operation_code",
      "source_document_id",
      "source_quote",
      "source_quote_sha256"
    ],
    "title": "ApplicabilityRule",
    "type": "object"
  },
  "ManufacturingQuestion": {
    "additionalProperties": false,
    "properties": {
      "conversation_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Conversation Id"
      },
      "expected_source_revision": {
        "anyOf": [
          {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Expected Source Revision"
      },
      "knowledge_base_id": {
        "anyOf": [
          {
            "format": "uuid",
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Knowledge Base Id"
      },
      "question": {
        "maxLength": 1000,
        "minLength": 1,
        "title": "Question",
        "type": "string"
      },
      "work_order_id": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "title": "Work Order Id",
        "type": "string"
      }
    },
    "required": [
      "question",
      "work_order_id"
    ],
    "title": "ManufacturingQuestion",
    "type": "object"
  },
