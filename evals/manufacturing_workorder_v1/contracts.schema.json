          },
          "route_revision": {
            "anyOf": [
              {
                "maxLength": 80,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Route Revision"
          },
          "schema_version": {
            "const": "work-order-v1",
            "default": "work-order-v1",
            "title": "Schema Version",
            "type": "string"
          },
          "source_record_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Source Record Id",
            "type": "string"
          },
          "source_revision": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Source Revision",
            "type": "string"
          },
          "source_system_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Source System Id",
            "type": "string"
          },
          "source_updated_at": {
            "format": "date-time",
            "title": "Source Updated At",
            "type": "string"
          },
          "status": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Status",
            "type": "string"
          },
          "tenant_id": {
            "format": "uuid",
            "title": "Tenant Id",
            "type": "string"
          },
          "work_order_id": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "title": "Work Order Id",
            "type": "string"
          }
        },
        "required": [
          "source_system_id",
          "tenant_id",
          "plant_code",
          "work_order_id",
          "source_record_id",
          "product_model",
          "operation_code",
          "actual_started_at",
          "actual_start_precision",
          "status",
          "source_revision",
          "source_updated_at"
        ],
        "title": "WorkOrderRecord",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "description": "A source record plus server-generated observation metadata.",
    "properties": {
      "fetched_at": {
        "format": "date-time",
        "title": "Fetched At",
        "type": "string"
      },
      "last_verified_at": {
        "format": "date-time",
        "title": "Last Verified At",
        "type": "string"
      },
      "payload_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "title": "Payload Sha256",
        "type": "string"
      },
      "record": {
        "$ref": "#/$defs/WorkOrderRecord"
      }
    },
    "required": [
      "record",
      "fetched_at",
      "last_verified_at",
      "payload_sha256"
    ],
    "title": "WorkOrderContext",
    "type": "object"
  },
