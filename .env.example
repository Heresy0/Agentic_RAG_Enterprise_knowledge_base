DATABASE_URL=postgresql+psycopg://enterprise_app:change-me@127.0.0.1:5432/enterprise_knowledge

POSTGRES_DB=enterprise_knowledge
POSTGRES_USER=enterprise_app
POSTGRES_PASSWORD=change-me

DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
DASHSCOPE_RERANK_MODEL=
DASHSCOPE_RERANK_URL=
RERANK_TIMEOUT_SECONDS=5

# Optional verified rates per 1,000,000 tokens; leave empty to record tokens without guessing cost.
# Keys: dashscope:<model>. Each entry requires currency/version plus input/output or total_per_million.
MODEL_USAGE_PRICES_JSON={}

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

OIDC_ISSUER=http://127.0.0.1:8080/realms/enterprise-knowledge
OIDC_AUDIENCE=enterprise-knowledge-api
OIDC_FRONTEND_CLIENT_ID=enterprise-knowledge-web
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/enterprise-knowledge/protocol/openid-connect/certs

LOG_LEVEL=INFO

DOCUMENT_STORAGE_DIR=data/documents
MAX_UPLOAD_BYTES=20971520
INDEXING_WORKER_POLL_SECONDS=2
INDEXING_JOB_RETRY_DELAY_SECONDS=30
INDEXING_JOB_STALE_AFTER_SECONDS=300
INDEXING_FAILED_FILE_RETENTION_HOURS=24
INDEXING_ORPHAN_FILE_RETENTION_HOURS=24
INDEXING_WORKER_HEARTBEAT_SECONDS=10
INDEXING_WORKER_STALE_SECONDS=30
INDEXING_WORKER_METRICS_PORT=9101

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

QA_RATE_LIMIT_REQUESTS=60
QA_RATE_LIMIT_WINDOW_SECONDS=60

QA_MAX_CONCURRENT_REQUESTS_PER_TENANT=3
QA_CONCURRENCY_LEASE_SECONDS=180

# Milvus REST v2; PostgreSQL retains permissions, text and BM25.
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=enterprise_chunks
MILVUS_TIMEOUT_SECONDS=10
MILVUS_TOKEN=
