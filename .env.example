DATABASE_URL=postgresql+psycopg://enterprise_app:change-me@127.0.0.1:5432/enterprise_knowledge

POSTGRES_DB=enterprise_knowledge
POSTGRES_USER=enterprise_app
POSTGRES_PASSWORD=change-me

DASHSCOPE_MODEL=
DASHSCOPE_BASE_URL=
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=
EMBEDDING_TIMEOUT_SECONDS=30
DASHSCOPE_RERANK_MODEL=
DASHSCOPE_RERANK_URL=
RERANK_TIMEOUT_SECONDS=5

# Optional verified rates per 1,000,000 tokens; leave empty to record tokens without guessing cost.
# Keys: dashscope:<model>. Each entry requires currency/version plus input/output or total_per_million.
MODEL_USAGE_PRICES_JSON={}

KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me

OIDC_ISSUER=http://127.0.0.1:8080/realms/enterprise-knowledge
OIDC_AUDIENCE=enterprise-knowledge-api
OIDC_FRONTEND_CLIENT_ID=enterprise-knowledge-web
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/enterprise-knowledge/protocol/openid-connect/certs

LOG_LEVEL=INFO

DOCUMENT_STORAGE_DIR=data/documents
MAX_UPLOAD_BYTES=20971520
INDEXING_WORKER_POLL_SECONDS=2
INDEXING_JOB_RETRY_DELAY_SECONDS=30
INDEXING_JOB_STALE_AFTER_SECONDS=300
INDEXING_FAILED_FILE_RETENTION_HOURS=24
INDEXING_ORPHAN_FILE_RETENTION_HOURS=24
INDEXING_WORKER_HEARTBEAT_SECONDS=10
INDEXING_WORKER_STALE_SECONDS=30
INDEXING_WORKER_METRICS_PORT=9101

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

QA_RATE_LIMIT_REQUESTS=60
QA_RATE_LIMIT_WINDOW_SECONDS=60

QA_MAX_CONCURRENT_REQUESTS_PER_TENANT=3
QA_CONCURRENCY_LEASE_SECONDS=180

# Milvus REST v2; PostgreSQL retains permissions, text and BM25.
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=enterprise_chunks
MILVUS_TIMEOUT_SECONDS=10
# Host-side evaluation uses the read account; indexing/sync scripts use the write account.
# Generate these ignored files with: python scripts/initialize_milvus_secrets.py
MILVUS_TOKEN_FILE=.secrets/milvus/api_token
MILVUS_WORKER_TOKEN_FILE=.secrets/milvus/worker_token

# Optional model-directed evidence collection after first retrieval.
# auto: comparisons, multiple question parts/periods, or empty/front-matter evidence.
# off disables Agent evidence tools; planner/repair have their own switches below.
# always is for controlled testing.
AGENTIC_RAG_MODE=auto
AGENT_MAX_DECISIONS=2
AGENT_MAX_SEARCHES=2
AGENT_MAX_READS=1
AGENT_MAX_EVIDENCE=24
AGENT_MAX_PROMPT_BYTES=12000
AGENT_MAX_OUTPUT_TOKENS=384
AGENT_MAX_DECISION_TOKENS=16000
AGENT_MAX_SECONDS=20
AGENT_DECISION_TIMEOUT_SECONDS=8

# Input intent planning; simple queries use local rules without a paid call.
RAG_PLANNER_MODE=auto
RAG_REPAIR_ENABLED=true
RAG_FEEDBACK_ENABLED=true
# Rerank child chunks, then resolve scoped current parent text (no parent vectors).
# Set 8/false to reproduce the child-only baseline; the initial fetch remains 30.
RAG_RERANK_TOP_K=12
RAG_PARENT_CONTEXT_ENABLED=true
# Whole parents by default; one guarded model selection only on context overflow.
RAG_CONTEXT_SELECTION_ENABLED=true
RAG_CONTEXT_SELECTION_OUTPUT_TOKENS=512
RAG_CONTEXT_SELECTION_PROMPT_BYTES=16000
RAG_CONTEXT_SELECTION_TIMEOUT_SECONDS=6
# Shared budget for planner + Agent + context selection + repair + regeneration.
# Initial retrieval/generation and conversation rewriting are accounted separately.
RAG_MAX_OPTIONAL_CALLS=4
RAG_MAX_OPTIONAL_TOKENS=32000
RAG_MAX_OPTIONAL_SECONDS=35
# Total searches includes initial, Agent supplements and the one feedback search.
RAG_MAX_SEARCHES=3
RAG_REGENERATION_OUTPUT_TOKENS=2048
RAG_REGENERATION_TIMEOUT_SECONDS=15
RAG_PLANNER_OUTPUT_TOKENS=768
RAG_PLANNER_TIMEOUT_SECONDS=8
RAG_REPAIR_OUTPUT_TOKENS=1536
RAG_REPAIR_TIMEOUT_SECONDS=8
RAG_REPAIR_PROMPT_BYTES=24000
# 保存私有问答快照并启用可追溯反馈；上线前执行数据库迁移。
QA_SNAPSHOTS_ENABLED=true

# 实验会话摘要的真实模型验收未通过，默认关闭；显式开启后从第七轮维护状态。
CONVERSATION_MEMORY_ENABLED=false
