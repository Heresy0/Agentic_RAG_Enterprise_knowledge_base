  "business_contract": {
    "mapping_basis": "reviewed_step_assignment",
    "assignment": "平台审核者为具体源系统/工厂/工单/批次/步骤及知识库明确分配已发布、已复核指导书业务版本，记录工艺编码和依据；不自动从步骤名称匹配，也不代填工单实际开工或套用工单开工窗口。",
    "review": "需知识库admin及业务view+review；草稿、复核、撤回均追加修订，比较预期修订并复读来源/原文。明确工单例外与分配冲突时拒绝。",
    "invalidation": "来源、指导书/制造复核/发布状态或对应步骤映射变化后重新采集审核；会话绑定映射摘要，变更在追问模型调用前返回409。",
    "references": "平台审核工艺编码与上游工单字段分开；applicability.step_guidance保留审核身份、版本及原因，文档引用保留原文与版本。",
    "quality": "批次/步骤证据保留真实实体和记录编号、父子选择、值、精度、修订与哈希；可回答样本必须有各级身份，作业样本还需有效映射及指导书/通知证据。",
    "freezing": "活跃实时来源登记及所选完整记录反复核验；同源同工单不同批次/步骤同组，禁止固定集/反馈集泄漏。旧版本不覆盖，来源或映射变化后旧冻结版本失效。",
    "worker": "沿用现有质量Worker和硬零预算CLI，传回相同批次/步骤并保留三次校验，不新增QA成功记录；新评分与旧ERP/工单评分分开。"
  },
